      TabOrder = 1
    end
    object FFollowSymbolicLinks: TCheckBox
      Left = 12
      Height = 23
      Top = 142
      Width = 596
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Follow symbolic links'
      OnChange = FollowLinksChanged
      OnEnter = ScrollFocusedControlIntoView

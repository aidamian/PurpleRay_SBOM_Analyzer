    end
    object FAllowOutsideRoot: TCheckBox
      Left = 34
      Height = 23
      Top = 169
      Width = 574
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Allow followed links to leave the selected root'
      OnEnter = ScrollFocusedControlIntoView
      TabOrder = 3
    end
    object FRememberPrivacyChoices: TCheckBox
      Left = 12
      Height = 23
      Top = 196
      Width = 596
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Remember absolute-path and outside-root choices for future scans'
      Hint = 'When unchecked, both privacy-sensitive choices reset before the next scan.'
      OnEnter = ScrollFocusedControlIntoView
      ShowHint = True
      TabOrder = 4
    end
    object FCalculateSHA256: TCheckBox
      Left = 12
      Height = 23
      Top = 225
      Width = 596
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Calculate SHA-256 for manifests and binaries'
      OnEnter = ScrollFocusedControlIntoView
      TabOrder = 5
    end
    object FUseRescanCache: TCheckBox
      Left = 12
      Height = 23
      Top = 254
      Width = 596
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Reuse verified evidence from the last successful scan'
      Hint = 'Every candidate is freshly SHA-256 hashed before a cache hit. Cache data stays in this application profile; turning reuse off does not delete it.'
      OnChange = RescanCacheChanged
      OnEnter = ScrollFocusedControlIntoView
      ShowHint = True
      TabOrder = 6
    end
    object FRefreshRescanCache: TCheckBox
      Left = 34
      Height = 23
      Top = 281
      Width = 574
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Full rescan this time and replace the verified cache'
      Hint = 'Bypass existing cached evidence for this scan, then replace it only after the SBOM is written successfully.'
      OnEnter = ScrollFocusedControlIntoView
      ShowHint = True
      TabOrder = 7
    end
    object FCheckKnownIssues: TCheckBox
      Left = 12
      Height = 23
      Top = 312
      Width = 596
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Check identified packages for known issues with OSV.dev (online)'
      Hint = 'This choice applies to this scan only and is never remembered.'
      OnEnter = ScrollFocusedControlIntoView
      ShowHint = True
      TabOrder = 8
    end
    object KnownIssuesDisclosureLabel: TLabel
      Left = 34
      Height = 50
      Top = 339
      Width = 574
      Anchors = [akTop, akLeft, akRight]
      AutoSize = False
      Caption = 'Unchecked every time. If selected, only eligible versioned Package URLs are sent after the inventory SBOM is written. No source files or SBOM are uploaded.'
      WordWrap = True
    end
    object AuthorPersistenceLabel: TLabel
      Left = 12
      Height = 44
      Top = 395
      Width = 596
      Anchors = [akTop, akLeft, akRight]
      AutoSize = False
      Caption = 'Optional author details persist locally and are included in generated SBOMs and database backups. Other settings persist; privacy choices reset unless remembered.'
      WordWrap = True
    end
